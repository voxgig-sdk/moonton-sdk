# Entity: game

main: kit: entity: game: {

  alias: field: {}

  fields: {
    active: {
      h: "Active"
      n: "active"
      r: false
      sh: "Whether the game is currently active"
      t: "`$BOOLEAN`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Brief description of the game"
      t: "`$STRING`"
    }
    genre: {
      h: "Genre"
      n: "genre"
      r: true
      sh: "Game genre"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the game"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Name of the game"
      t: "`$STRING`"
    }
    platforms: {
      h: "Platforms"
      n: "platforms"
      r: false
      sh: "Platforms where the game is available"
      t: "`$ARRAY`"
    }
    playerCount: {
      h: "Player Count"
      n: "playerCount"
      r: false
      sh: "Current active player count"
      t: "`$INTEGER`"
    }
    releaseDate: {
      fo: "date"
      h: "Release Date"
      n: "releaseDate"
      r: false
      sh: "Release date of the game"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "game"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /games"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/games"
          q: {
            exist: [
              "limit"
              "offset"
            ]
          }
          s: [
            {
              lit: "games"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
